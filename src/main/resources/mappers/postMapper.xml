<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.bbar.sns.post.repository.PostRepository">
 	<insert id="insertPost" parameterType="map">
 		INSERT INTO 
 			`post`
        (
        	`userId`
        	, `contents`
        	, `imagePath`
        	, `createdAt`
        	, `updatedAt`
        )
        VALUES
        (
        	#{userId}
        	, #{contents}
        	, #{imagePath}
        	, NOW()
        	, NOW()
        )
 	</insert>
 	
 	<select id="findAllPosts" resultType="com.bbar.sns.post.domain.Post">
        SELECT * FROM post ORDER BY id DESC
    </select>
 	
 	<select id="findById" parameterType="int" resultType="com.bbar.sns.post.domain.Post">
        SELECT * FROM post WHERE id = #{id}
    </select>
 	
 	<delete id="deletePost" parameterType="int">
    	DELETE FROM `post`
   		WHERE id = #{id}
	</delete>
	
 </mapper>
 